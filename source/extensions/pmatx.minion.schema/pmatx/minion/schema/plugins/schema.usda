#usda 1.0
(
    doc = "usdGenSchema authoring layer for pmatxMinion (codeful resource plugin)."
    subLayers = [
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "pmatxMinion"
        string libraryPath = "."
        string libraryPrefix = "pmatx"
    }
) {
}

class Minion "Minion" (
    inherits = </Capsule>
    prepend apiSchemas = ["PhysxCharacterControllerAPI"]
    doc = "ECA wireframe component base class"
)
{
    string name = "" (
        doc = "Your minions name"
    )
}
